{
  "name": "polycrew",
  "version": "0.0.1",
  "description": "Several agents - and the people among them - working one polyflow run at the same time. Coordination is a journaled step of a machine that was checked before it loaded; agents never talk to each other, they talk to the run.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cognitive-fab/polycrew.git"
  },
  "homepage": "https://github.com/cognitive-fab/polycrew#readme",
  "bugs": {
    "url": "https://github.com/cognitive-fab/polycrew/issues"
  },
  "keywords": [
    "ai-agents",
    "mcp",
    "multi-agent",
    "workflow-engine",
    "state-machine",
    "polyflow"
  ],
  "bin": {
    "polycrew": "bin/polycrew.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --no-warnings --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "polyflow": "https://github.com/cognitive-fab/polyflow/archive/4d2d67858816e5b76353eeba026a966df284182b.tar.gz"
  }
